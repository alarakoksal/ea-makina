<style>
    :root {
        --primary-gold: #f59e0b;
        --deep-dark: #111827;
        --soft-gray: #f3f4f6;
    }

   
    
    .hero-section {
        height: 90vh;
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/hero.jpg');
        background-attachment: fixed;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        clip-path: polygon(0 0, 100% 0, 100% 95%, 0% 100%);
    }

    
    .stat-box {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(15px);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .stat-box:hover {
        transform: translateY(-10px) scale(1.05);
        border-color: var(--primary-gold);
        background: rgba(245, 158, 11, 0.1);
    }

    
    .machine-item {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    }

    .machine-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 320px;
    }

    .machine-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .machine-item:hover .machine-img-wrapper img {
        transform: scale(1.1) rotate(2deg);
    }

    .machine-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: var(--primary-gold);
        color: #000;
        padding: 5px 15px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 12px;
        z-index: 5;
    }

    .machine-info {
        padding: 25px;
        border-top: 4px solid var(--primary-gold);
    }

    
    .reveal-scroll { opacity: 0; transform: translateY(50px); transition: 1s all ease; }
    .reveal-scroll.active { opacity: 1; transform: translateY(0); }
</style>

<section class="hero-section text-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <span class="badge mb-3 py-2 px-3" style="background: var(--primary-gold); color:#000">PROFESYONEL ÇÖZÜMLER</span>
                <h1 class="display-2 fw-black mb-4" style="line-height: 1.1;">
                    Zorlu İşler İçin <br> <span style="color: var(--primary-gold);">Devasa Güç</span>
                </h1>
                <p class="lead mb-5 opacity-75">Sadece makine değil, projenizin başarısı için hız ve verimlilik kiralıyoruz.</p>
                
                <div class="d-flex flex-wrap gap-4 mt-5">
                    <div class="stat-box p-4 flex-fill text-center slide-right">
                        <h2 class="fw-bold mb-0 text-warning">+35</h2>
                        <small class="text-uppercase tracking-widest" style="font-size: 10px;">Modern Makine</small>
                    </div>
                    <div class="stat-box p-4 flex-fill text-center slide-right" style="transition-delay: 0.2s">
                        <h2 class="fw-bold mb-0 text-warning">7/24</h2>
                        <small class="text-uppercase tracking-widest" style="font-size: 10px;">Teknik Destek</small>
                    </div>
                    <div class="stat-box p-4 flex-fill text-center slide-right" style="transition-delay: 0.4s">
                        <h2 class="fw-bold mb-0 text-warning">%100</h2>
                        <small class="text-uppercase tracking-widest" style="font-size: 10px;">Müşteri Memnuniyeti</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5" style="background: var(--soft-gray);">
    <div class="container py-5">
        <div class="row align-items-end mb-5 reveal-scroll">
            <div class="col-md-6">
                <h6 class="text-warning fw-bold text-uppercase">Kategoriler</h6>
                <h2 class="display-5 fw-bold">Makine Parkımız</h2>
            </div>
            <div class="col-md-6 text-md-end">
                <p class="text-muted">En güncel emisyon standartlarına uygun, bakımlı ve yüksek performanslı makinelerimizi keşfedin.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6 reveal-scroll">
                <div class="machine-item shadow-hover">
                    <div class="machine-badge shadow-sm">KİRALANABİLİR</div>
                    <div class="machine-img-wrapper">
                        <img src="/images/k.exc.jpg" alt="Ekskavatör">
                    </div>
                    <div class="machine-info">
                        <h4 class="fw-bold">Ağır Hizmet Ekskavatörü</h4>
                        <div class="d-flex justify-content-between text-muted mb-3">
                            <span><i class="bi bi-gear-fill text-warning"></i> 14-70 Ton</span>
                            <span><i class="bi bi-fuel-pump-fill text-warning"></i> Dizel</span>
                        </div>
                        <a href="/Home/Details" class="btn btn-outline-dark w-100 rounded-pill fw-bold mt-2">Detayları Gör</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 reveal-scroll" style="transition-delay: 0.2s">
                <div class="machine-item shadow-hover">
                    <div class="machine-badge shadow-sm">POPÜLER</div>
                    <div class="machine-img-wrapper">
                        <img src="/images/v.lod.jpg" alt="Loder">
                    </div>
                    <div class="machine-info">
                        <h4 class="fw-bold">Yükleyici Loder</h4>
                        <div class="d-flex justify-content-between text-muted mb-3">
                            <span><i class="bi bi-gear-fill text-warning"></i> Seri Hareket</span>
                            <span><i class="bi bi-fuel-pump-fill text-warning"></i> Yüksek Verim</span>
                        </div>
                        <a href="/Home/Details" class="btn btn-outline-dark w-100 rounded-pill fw-bold mt-2">Detayları Gör</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 reveal-scroll" style="transition-delay: 0.4s">
                <div class="machine-item shadow-hover">
                    <div class="machine-badge shadow-sm">ÇOK YÖNLÜ</div>
                    <div class="machine-img-wrapper">
                        <img src="/images/k.bek.jpg" alt="Bekoloder">
                    </div>
                    <div class="machine-info">
                        <h4 class="fw-bold">Kazıcı Yükleyici</h4>
                        <div class="d-flex justify-content-between text-muted mb-3">
                            <span><i class="bi bi-gear-fill text-warning"></i> Kompakt Tasarım</span>
                            <span><i class="bi bi-fuel-pump-fill text-warning"></i> 4x4</span>
                        </div>
                        <a href="/Home/Details" class="btn btn-outline-dark w-100 rounded-pill fw-bold mt-2">Detayları Gör</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="position-relative py-5 overflow-hidden" style="background: var(--deep-dark);">
    <div class="container py-4 position-relative" style="z-index: 2;">
        <div class="row align-items-center">
            <div class="col-lg-8 text-white">
                <h2 class="display-6 fw-bold">Projeniz İçin Fiyat Teklifi Alın</h2>
                <p class="opacity-50">Uzman ekibimiz size en uygun makine seçimi için yardımcı olmaya hazır.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="/Home/Contact" class="btn btn-warning btn-lg px-5 py-3 rounded-pill fw-black shadow-lg hover-scale">
                    BİZE ULAŞIN <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    
    window.addEventListener("load", function() {
        const navLinks = document.querySelectorAll('.nav-link');
        navLinks.forEach(link => {
            if(link.innerText.includes('Kiralama')) {
                link.classList.add('active');
                link.style.setProperty('color', '#ffffff', 'important');
                link.style.setProperty('font-weight', '800', 'important');
            }
        });
    });

    // Scroll 
    function reveal() {
        var reveals = document.querySelectorAll(".reveal-scroll");
        for (var i = 0; i < reveals.length; i++) {
            var windowHeight = window.innerHeight;
            var elementTop = reveals[i].getBoundingClientRect().top;
            var elementVisible = 150;
            if (elementTop < windowHeight - elementVisible) {
                reveals[i].classList.add("active");
            }
        }
    }

    window.addEventListener("scroll", reveal);
    window.addEventListener("load", reveal);
</script>