<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eada | Heavy Duty Excellence</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Inter:wght@300;600;900&display=swap');

        :root {
            --accent: #f59e0b;
            --bg: #050505;
            --white-bg: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: var(--bg); color: #fff; font-family: 'Inter', sans-serif; overflow-x: hidden; }

        .hero-reveal { animation: reveal 1.5s cubic-bezier(0.77, 0, 0.175, 1); }
        @@keyframes reveal {
            0% { transform: translateY(100px); opacity: 0; }
            100% { transform: translateY(0); opacity: 1; }
        }

        .hero-premium {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr;
            align-items: center;
            position: relative;
            padding: 80px 8%;
        }

        .bg-video-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        #bgVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.4) contrast(1.2);
            scale: 1.1;
            transition: filter 1.5s ease;
        }

        .video-active { filter: brightness(0.6) contrast(1.1) !important; }

        .hero-text-layer { z-index: 10; position: relative; }

        .pre-title {
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 8px;
            font-size: 0.9rem;
            margin-bottom: 15px;
            display: block;
            font-weight: 600;
        }

        .main-title-premium {
            font-family: 'Syncopate', sans-serif;
            font-size: clamp(2.2rem, 8vw, 8rem); /* Mobilde küçültüldü */
            font-weight: 700;
            line-height: 0.9;
            text-transform: uppercase;
            margin-bottom: 30px;
            letter-spacing: -2px;
        }

        .main-title-premium span {
            display: block;
            color: transparent;
            -webkit-text-stroke: 1px #fff;
        }

        .hero-grid-premium {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 50px;
            max-width: 1200px;
        }

        .glass-card-premium {
            background: rgba(255,255,255,0.03);
            border-left: 3px solid var(--accent);
            padding: 30px;
            backdrop-filter: blur(10px);
            transition: 0.5s all ease;
            cursor: pointer;
        }

        .glass-card-premium:hover {
            background: var(--accent);
            transform: scale(1.05);
        }

        .glass-card-premium:hover h3, .glass-card-premium:hover p { color: #000; }
        .glass-card-premium h3 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: var(--accent); }
        .glass-card-premium p { text-transform: uppercase; font-size: 0.65rem; letter-spacing: 1px; opacity: 0.7; }

        .cta-box-premium {
            position: absolute;
            bottom: 50px;
            right: 8%;
            display: flex;
            align-items: center;
            gap: 25px;
            z-index: 20;
        }

        .round-btn-premium {
            width: 120px;
            height: 120px;
            border: 1px solid var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #fff;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.7rem;
            transition: 0.5s;
            background: transparent;
            text-align: center;
        }

        .brand-section-wrapper {
            background: var(--white-bg);
            padding: 60px 0 20px 0; 
            border-top: 10px solid var(--accent);
            text-align: center;
        }

        .brand-section-header h2 {
            font-family: 'Syncopate', sans-serif;
            font-size: clamp(1rem, 4vw, 2.2rem);
            color: #000;
            letter-spacing: 5px; /* Mobilde daraltıldı */
            text-transform: uppercase;
            margin-bottom: 15px;
            padding: 0 15px;
        }

        .brand-section-header .line {
            width: 60px;
            height: 4px;
            background: var(--accent);
            margin: 0 auto 30px; 
        }

        .premium-brand-strip {
            background: var(--white-bg);
            padding: 10px 0 30px 0; 
            display: flex;
            overflow: hidden;
            position: relative;
            z-index: 30;
            align-items: center;
        }

        .premium-brand-track {
            display: flex;
            width: max-content;
            animation: premiumMoveBrands 30s linear infinite;
            align-items: center;
        }

        .premium-brand-item { padding: 0 40px; } /* Mobilde mesafe daraltıldı */

        /* Logo Ayarları */
        .premium-brand-item img { height: 60px; object-fit: contain; }
        .logo-cat { height: 70px !important; transform: scale(0.8) !important; }
        .logo-komatsu { height: 70px !important; transform: scale(1.4) !important; }
        .logo-hitachi { height: 70px !important; transform: scale(1.4) !important; }
        .logo-volvo { height: 60px !important; transform: scale(1.1) !important; }
        .logo-xcmg { height: 70px !important; }

        @@keyframes premiumMoveBrands {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .luxury-services-wrapper {
            background: var(--white-bg);
            padding: 40px 0 80px 0; 
        }

        .section-header h2 {
            font-family: 'Syncopate', sans-serif;
            font-size: 1.8rem;
            color: #111;
            letter-spacing: 5px;
            text-transform: uppercase;
        }

        .luxury-services-grid {
            padding: 0 8%;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .service-card-luxury {
            background: linear-gradient(145deg, #111, #080808);
            border-radius: 24px;
            padding: 40px 30px;
            text-align: center;
            color: #fff;
        }

        .visual-frame { height: 150px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center; }
        .visual-frame img { max-width: 180px; height: auto; }

        /* 🔥 MOBİL ÖZEL AYARLAR (RESPONSIVE) */
        @@media (max-width: 768px) {
            .hero-premium { padding-top: 120px; height: auto; padding-bottom: 50px; }
            .main-title-premium { letter-spacing: -1px; margin-bottom: 15px; }
            .hero-grid-premium { grid-template-columns: 1fr; gap: 15px; }
            .cta-box-premium { 
                position: relative; 
                right: auto; 
                bottom: auto; 
                justify-content: center; 
                margin-top: 40px; 
            }
            .round-btn-premium { width: 100px; height: 100px; font-size: 0.6rem; }
            .brand-section-header h2 { letter-spacing: 3px; }
            .premium-brand-item { padding: 0 25px; }
            /* Mobilde logoları biraz daha küçültüyoruz ki taşmasın */
            .logo-komatsu, .logo-hitachi { transform: scale(1.1) !important; height: 50px !important; }
            .logo-cat, .logo-xcmg { height: 50px !important; }
        }
    </style>
</head>
<body>

    <section class="hero-premium" onmousemove="initVideo()">
        <div class="bg-video-container">
            <video id="bgVideo" muted loop playsinline preload="auto">
                <source src="/videos/xcmg_video.mp4" type="video/mp4">
            </video>
        </div>

        <div class="hero-text-layer hero-reveal">
            <span class="pre-title">Eada Heavy Industries</span>
            <h1 class="main-title-premium">
                Sınırları <span>Zorla</span><br>Gücü Hisset
            </h1>
            
            <div class="hero-grid-premium">
                <div class="glass-card-premium">
                    <h3>+<span class="counter" data-target="100">0</span></h3>
                    <p>Tamamlanan Proje</p>
                </div>
                <div class="glass-card-premium">
                    <h3>+<span class="counter" data-target="35">0</span></h3>
                    <p>Dev Makine Parkı</p>
                </div>
                <div class="glass-card-premium">
                    <h3>%<span class="counter" data-target="100">0</span></h3>
                    <p>Müşteri Güveni</p>
                </div>
            </div>
        </div>

        <div class="cta-box-premium animate__animated animate__fadeInUp">
            <a href="/Home/Contact" class="round-btn-premium">Bize<br>Ulaşın</a>
        </div>
    </section>

    <section class="brand-section-wrapper">
        <div class="brand-section-header">
            <h2><span>ÇÖZÜM ORTAĞI</span> OLDUĞUMUZ MARKALAR</h2>
            <div class="line"></div>
        </div>
        
        <div class="premium-brand-strip">
            <div class="premium-brand-track">
                <div class="premium-brand-item"><img src="/images/xcmg.png" class="logo-xcmg"></div>
                <div class="premium-brand-item"><img src="/images/cat.png" class="logo-cat"></div>
                <div class="premium-brand-item"><img src="/images/hy.png" class="logo-hyundai"></div>
                <div class="premium-brand-item"><img src="/images/hit.png" class="logo-hitachi"></div>
                <div class="premium-brand-item"><img src="/images/vol.png" class="logo-volvo"></div>
                <div class="premium-brand-item"><img src="/images/kom.png" class="logo-komatsu"></div>
                <div class="premium-brand-item"><img src="/images/xcmg.png" class="logo-xcmg"></div>
                <div class="premium-brand-item"><img src="/images/cat.png" class="logo-cat"></div>
                <div class="premium-brand-item"><img src="/images/hy.png" class="logo-hyundai"></div>
                <div class="premium-brand-item"><img src="/images/hit.png" class="logo-hitachi"></div>
                <div class="premium-brand-item"><img src="/images/vol.png" class="logo-volvo"></div>
                <div class="premium-brand-item"><img src="/images/kom.png" class="logo-komatsu"></div>
            </div>
        </div>
    </section>

    <section class="luxury-services-wrapper">
        <div class="section-header">
            <h2>HİZMETLERİMİZ</h2>
            <div class="line"></div>
        </div>

        <div class="luxury-services-grid">
            <div class="service-card-luxury">
                <div class="visual-frame"><img src="/images/kutu1.png" alt="Kiralama"></div>
                <div class="data-badge">+35 DEV MAKİNE PARKI</div>
                <h2>KİRALAMA</h2>
                <p>Projelerinizin gücünü artırın. Esnek zaman planlaması ve operatör desteğiyle yanınızdayız.</p>
                <a href="#" class="luxury-btn">FİLOYU İNCELE</a>
            </div>
            <div class="service-card-luxury">
                <div class="visual-frame"><img src="/images/kutu2.png" alt="Revizyon"></div>
                <div class="data-badge">%100 PERFORMANS ODAKLI</div>
                <h2>REVİZYON</h2>
                <p>Makinelerinizin ömrünü uzatıyoruz. Motor ve hidrolik sistemlerde sıfır kondisyonu.</p>
                <a href="#" class="luxury-btn">TEKNİK SERVİS AL</a>
            </div>
            <div class="service-card-luxury">
                <div class="visual-frame"><img src="/images/kutu3.png" alt="Yedek Parça"></div>
                <div class="data-badge">10K+ ORİJİNAL ÜRÜN</div>
                <h2>YEDEK PARÇA</h2>
                <p>Dünya devlerinin onaylı parçaları. Stoktan anında teslimat ve garanti güvencesi.</p>
                <a href="#" class="luxury-btn">PARÇA SİPARİŞİ</a>
            </div>
        </div>
    </section>

    <script>
        let videoStarted = false;
        const v = document.getElementById('bgVideo');

        function initVideo() {
            if (!videoStarted) {
                v.play().then(() => {
                    videoStarted = true;
                    v.classList.add('video-active');
                }).catch(err => console.log("Oynatma bekleniyor..."));
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const counters = document.querySelectorAll('.counter');
            const runCounters = () => {
                counters.forEach(c => {
                    const target = +c.getAttribute('data-target');
                    let now = 0;
                    const update = () => {
                        const step = target / 60;
                        if(now < target) {
                            now += step;
                            c.innerText = Math.ceil(now);
                            requestAnimationFrame(update);
                        } else { c.innerText = target; }
                    };
                    update();
                });
            };
            setTimeout(runCounters, 800);
            document.addEventListener('mousedown', initVideo, {once:true});
            document.addEventListener('touchstart', initVideo, {once:true});
        });
    </script>
</body>
</html>